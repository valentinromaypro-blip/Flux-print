# Base Postgres (Supabase en production, locale en développement)
FLUX_DATABASE_URL=postgres://postgres@localhost:5499/fp_site
# Stockage : "local:/chemin" (développement) ou "supabase"
FLUX_STORAGE=local:../../var/storage
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Secret de signature du cookie de session (32+ caractères aléatoires)
SESSION_SECRET=change-me-change-me-change-me-change-me
# Adresse publique du site (liens de paiement)
SITE_URL=http://localhost:3000
# Paiement : test | stripe | revolut
PAYMENT_PROVIDER=test
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
REVOLUT_SECRET_KEY=
REVOLUT_WEBHOOK_SECRET=
REVOLUT_SANDBOX=true
# Accès au back-office /admin
ADMIN_PASSWORD=
